          <datasource-dependencies datasource='federated.0oc201l09mngjh1bj2k8m1bvnf1p'>
            <column caption='Bene Esrd Ind' datatype='integer' name='[BENE_ESRD_IND]' role='measure' type='quantitative' />
            <column caption='ESRD Prevalence' datatype='real' name='[Calculation_0099124195721220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [BENE_ESRD_IND] &gt; 0 THEN 1 ELSE 0 END) * 100' />
            </column>
            <column caption='Diabetes prevalence' datatype='real' name='[Calculation_0099124200058885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([has_Diabetes])*100' />
            </column>
            <column caption='CKD Prevalence' datatype='real' name='[Calculation_0099124201156614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([has_CKD])*100' />
            </column>
            <column caption='Heart Failure Prevalence' datatype='real' name='[Calculation_0099124201291783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([has_Heart Failure])*100' />
            </column>
            <column caption='Cancer Prevalence' datatype='real' name='[Calculation_0099124201955336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([has_Cancer])*100' />
            </column>
            <column caption='COPD Prevalence' datatype='real' name='[Calculation_0099124202041353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([has_COPD])*100' />
            </column>
            <column caption='Cost Burden Profile (&gt;10% prevalence threshold)' datatype='string' name='[Calculation_1281512268963856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High prevalence of both payer spending and OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &lt;= 0.1 &#10;THEN &quot;High payer cost prevalence, lower OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &lt;= 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High OOP burden prevalence, lower payer cost&quot; &#10;&#10;ELSE &quot;Low prevalence of both&quot; &#10;END' />
            </column>
            <column caption='High OOP Burden' datatype='integer' name='[High_OOP_Burden]' role='measure' type='quantitative' />
            <column caption='High Payer Cost' datatype='integer' name='[High_Payer_Cost]' role='measure' type='quantitative' />
