              <calculation class='tableau' formula='&quot;Num Pde Claims&quot;' />
              <aliases>
                <alias key='&quot;Num Carrier Claims&quot;' value='Carrier Claims' />
                <alias key='&quot;Num Ip Claims&quot;' value='Inpatient Claims' />
                <alias key='&quot;Num Op Claims&quot;' value='Outpatient Claims' />
                <alias key='&quot;Num Pde Claims&quot;' value='Prescription Drug Claims' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0oc201l09mngjh1bj2k8m1bvnf1p'>
            <column caption='Cost Burden Profile (&gt;10% prevalence threshold)' datatype='string' name='[Calculation_1281512268963856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High prevalence of both payer spending and OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &lt;= 0.1 &#10;THEN &quot;High payer cost prevalence, lower OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &lt;= 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High OOP burden prevalence, lower payer cost&quot; &#10;&#10;ELSE &quot;Low prevalence of both&quot; &#10;END' />
            </column>
            <column caption='Selected Utilization Value' datatype='real' name='[Calculation_1780141087322121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1780141085351941] WHEN &quot;Num Ip Claims&quot; THEN AVG([num_ip_claims])&#10;WHEN &quot;Num Op Claims&quot; THEN AVG([num_op_claims])&#10;WHEN &quot;Num Carrier Claims&quot; THEN AVG([num_carrier_claims])&#10;WHEN &quot;Num Pde Claims&quot; THEN AVG([num_pde_claims])&#10;END' />
            </column>
            <column caption='High OOP Burden' datatype='integer' name='[High_OOP_Burden]' role='measure' type='quantitative' />
            <column caption='High Payer Cost' datatype='integer' name='[High_Payer_Cost]' role='measure' type='quantitative' />
            <column caption='Race' datatype='string' name='[RACE]' role='dimension' type='nominal' />
            <column datatype='string' name='[SEX]' role='dimension' type='nominal' />
            <column caption='Age Band' datatype='string' name='[age_band]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1281512268963856]' derivation='None' name='[none:Calculation_1281512268963856:nk]' pivot='key' type='nominal' />
            <column caption='Num Carrier Claims' datatype='real' name='[num_carrier_claims]' role='measure' type='quantitative' />
            <column caption='Num Ip Claims' datatype='real' name='[num_ip_claims]' role='measure' type='quantitative' />
            <column caption='Num Op Claims' datatype='real' name='[num_op_claims]' role='measure' type='quantitative' />
            <column caption='Num Pde Claims' datatype='real' name='[num_pde_claims]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1780141087322121]' derivation='User' name='[usr:Calculation_1780141087322121:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0oc201l09mngjh1bj2k8m1bvnf1p].[Action (Cost Burden Profile (&gt;10% prevalence threshold))]'>
            <groupfilter function='level-members' level='[Calculation_1281512268963856]' user:ui-action-filter='[Action5_3416A737D22742729F9BAE22088059D4]' user:ui-enumeration='all' user:ui-marker='enumerate' />
