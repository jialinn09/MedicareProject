      <column aggregation='Sum' caption='Bene County Cd' datatype='integer' name='[BENE_COUNTY_CD]' role='dimension' type='ordinal' />
      <column caption='Bene Esrd Ind' datatype='integer' name='[BENE_ESRD_IND]' role='measure' type='quantitative' />
      <column caption='Part A Coverage Status' datatype='real' name='[Calculation_0099124178206720]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='AVG(&#10;IF [PART_A_INSUR_CVRAGE_TOT_MONS] &gt; 0&#10;THEN 1&#10;ELSE 0&#10;END&#10;) * 100' />
      </column>
      <column caption='Part B coverage %' datatype='real' name='[Calculation_0099124186394625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [PART_B_INSUR_CVRAGE_TOT_MONS] &gt; 0&#10;THEN 1&#10;ELSE 0&#10;END&#10;) * 100' />
      </column>
      <column caption='Part D Coverage %' datatype='real' name='[Calculation_0099124193320962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [PART_D_INSUR_CVRAGE_TOT_MONS] &gt; 0&#10;THEN 1&#10;ELSE 0&#10;END&#10;) * 100' />
      </column>
      <column caption='HMO Coverage %' datatype='real' name='[Calculation_0099124193505283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [HMO_INSUR_CVRAGE_TOT_MONS] &gt; 0&#10;THEN 1&#10;ELSE 0&#10;END&#10;) * 100' />
      </column>
      <column caption='ESRD Prevalence' datatype='real' name='[Calculation_0099124195721220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [BENE_ESRD_IND] &gt; 0 THEN 1 ELSE 0 END) * 100' />
      </column>
      <column caption='Diabetes prevalence' datatype='real' name='[Calculation_0099124200058885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([has_Diabetes])*100' />
      </column>
      <column caption='CKD Prevalence' datatype='real' name='[Calculation_0099124201156614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([has_CKD])*100' />
      </column>
      <column caption='Heart Failure Prevalence' datatype='real' name='[Calculation_0099124201291783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([has_Heart Failure])*100' />
      </column>
      <column caption='Cancer Prevalence' datatype='real' name='[Calculation_0099124201955336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([has_Cancer])*100' />
      </column>
      <column caption='COPD Prevalence' datatype='real' name='[Calculation_0099124202041353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([has_COPD])*100' />
      </column>
      <column caption='num_documented_conditions' datatype='real' name='[Calculation_0099124202569738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[has_Additional cardiovascular burden]+&#10;[has_Additional endocrine/metabolic burden]+&#10;[has_Additional GI/Hepatic burden]+&#10;[has_Additional Hematologic burden]+&#10;[has_Additional mental health burden]+&#10;[has_Additional Musculoskeletal Burden]+&#10;[has_Additional neurologic burden]+&#10;[has_Additional renal burden]+&#10;[has_Cancer]+&#10;[has_CKD]+&#10;[has_COPD]+&#10;[has_Depression]+&#10;[has_Diabetes]+&#10;[has_Genitourinary (non-renal) burden]+&#10;[has_Heart Failure]+&#10;[has_Infectious disease burden]+&#10;[has_Injury/Frailty Burden]+&#10;[has_Rheumatoid Arthritis/Osteoarthritis]+&#10;[has_Sensory Burden]+&#10;[has_Stroke/TIA]' />
      </column>
      <column caption='High OOP burden prevalence' datatype='real' name='[Calculation_0099124206194699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([High_OOP_Burden])*100' />
      </column>
      <column caption='High payer cost prevalence' datatype='real' name='[Calculation_0099124206280716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([High_Payer_Cost])*100' />
      </column>
      <column caption='Service Interaction Category' datatype='string' name='[Calculation_1281512241860608]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([num_service_types]) &lt; 2 THEN &quot;Below 2 Service Types&quot;&#10;ELSE &quot;2+ Service Types&quot;&#10;END' />
      </column>
      <column caption='High Payer Cost Indicator' datatype='string' name='[Calculation_1281512267538445]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([High_Payer_Cost]) &gt;= 0.1 THEN &quot;High Risk&quot;&#10;ELSE &quot;Below 10%&quot;&#10;END' />
      </column>
      <column caption='High OOP Indicator' datatype='string' name='[Calculation_1281512267976718]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([High_OOP_Burden]) &gt;= 0.1 THEN &quot;High OOP Burden&quot;&#10;ELSE &quot;Below 10%&quot;&#10;END' />
      </column>
      <column caption='Cost Burden Profile (&gt;10% prevalence threshold)' datatype='string' name='[Calculation_1281512268963856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High prevalence of both payer spending and OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &lt;= 0.1 &#10;THEN &quot;High payer cost prevalence, lower OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &lt;= 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High OOP burden prevalence, lower payer cost&quot; &#10;&#10;ELSE &quot;Low prevalence of both&quot; &#10;END' />
      </column>
      <column caption='Selected Disease Value' datatype='real' name='[Calculation_1780141086801928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1780141083463683] WHEN &quot;Diabetes&quot; THEN [Calculation_0099124200058885]&#10;WHEN &quot;Cancer&quot; THEN [Calculation_0099124201955336]&#10;WHEN &quot;CKD&quot; THEN [Calculation_0099124201156614]&#10;WHEN &quot;COPD&quot; THEN [Calculation_0099124202041353]&#10;WHEN &quot;ESRD&quot; THEN [Calculation_0099124195721220]&#10;WHEN &quot;Heart Failure&quot; THEN [Calculation_0099124201291783]&#10;END' />
      </column>
      <column caption='Selected Utilization Value' datatype='real' name='[Calculation_1780141087322121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1780141085351941] WHEN &quot;Num Ip Claims&quot; THEN AVG([num_ip_claims])&#10;WHEN &quot;Num Op Claims&quot; THEN AVG([num_op_claims])&#10;WHEN &quot;Num Carrier Claims&quot; THEN AVG([num_carrier_claims])&#10;WHEN &quot;Num Pde Claims&quot; THEN AVG([num_pde_claims])&#10;END' />
      </column>
      <column caption='Selected Cost Value' datatype='real' name='[Calculation_1780141088043021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1780141086003207] WHEN &quot;IPBene&quot; THEN AVG([total_inpatient_beneficiary_cost])&#10;WHEN &quot;IPIns&quot; THEN AVG([total_inpatient_insurance_cost_adj])&#10;WHEN &quot;OPBene&quot; THEN AVG([total_outpatient_beneficiary_cost])&#10;WHEN &quot;OPIns&quot; THEN AVG([total_outpatient_insurance_cost_adj])&#10;WHEN &quot;CarrierBene&quot; THEN AVG([total_carrier_beneficiary_cost])&#10;WHEN &quot;CarrierIns&quot; THEN AVG([total_carrier_insurance_cost])&#10;WHEN &quot;Drug&quot; THEN AVG([total_raw_drug_cost])&#10;WHEN &quot;Medoop&quot; THEN AVG([total_medoop])&#10;END' />
      </column>
