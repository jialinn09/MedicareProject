    <worksheet name='Cost Composition by Segment'>
      <table>
        <view>
          <datasources>
            <datasource caption='patient_final' name='federated.0oc201l09mngjh1bj2k8m1bvnf1p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Drug Insurance $' caption='Cost Selector' datatype='string' name='[Parameter 1780141086003207]' param-domain-type='list' role='measure' type='nominal' value='&quot;Drug&quot;'>
              <calculation class='tableau' formula='&quot;Drug&quot;' />
              <aliases>
                <alias key='&quot;CarrierBene&quot;' value='Carrier Beneficiary $' />
                <alias key='&quot;CarrierIns&quot;' value='Carrier Insurance $' />
                <alias key='&quot;Drug&quot;' value='Drug Insurance $' />
                <alias key='&quot;IPBene&quot;' value='Inpatient Beneficiary $' />
                <alias key='&quot;IPIns&quot;' value='Inpatient Insurance $' />
                <alias key='&quot;Medoop&quot;' value='Drug Beneficiary $' />
                <alias key='&quot;OPBene&quot;' value='Outpatient Beneficiary $' />
                <alias key='&quot;OPIns&quot;' value='Outpatient Insurance $' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0oc201l09mngjh1bj2k8m1bvnf1p'>
            <column caption='Cost Burden Profile (&gt;10% prevalence threshold)' datatype='string' name='[Calculation_1281512268963856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High prevalence of both payer spending and OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &gt; 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &lt;= 0.1 &#10;THEN &quot;High payer cost prevalence, lower OOP burden&quot; &#10;&#10;ELSEIF {FIXED [SEX],[RACE],[age_band] : AVG([High_Payer_Cost])} &lt;= 0.1 AND &#10;{FIXED [SEX],[RACE],[age_band] : AVG([High_OOP_Burden])} &gt; 0.1 &#10;THEN &quot;High OOP burden prevalence, lower payer cost&quot; &#10;&#10;ELSE &quot;Low prevalence of both&quot; &#10;END' />
            </column>
            <column caption='Selected Cost Value' datatype='real' name='[Calculation_1780141088043021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1780141086003207] WHEN &quot;IPBene&quot; THEN AVG([total_inpatient_beneficiary_cost])&#10;WHEN &quot;IPIns&quot; THEN AVG([total_inpatient_insurance_cost_adj])&#10;WHEN &quot;OPBene&quot; THEN AVG([total_outpatient_beneficiary_cost])&#10;WHEN &quot;OPIns&quot; THEN AVG([total_outpatient_insurance_cost_adj])&#10;WHEN &quot;CarrierBene&quot; THEN AVG([total_carrier_beneficiary_cost])&#10;WHEN &quot;CarrierIns&quot; THEN AVG([total_carrier_insurance_cost])&#10;WHEN &quot;Drug&quot; THEN AVG([total_raw_drug_cost])&#10;WHEN &quot;Medoop&quot; THEN AVG([total_medoop])&#10;END' />
            </column>
            <column caption='High OOP Burden' datatype='integer' name='[High_OOP_Burden]' role='measure' type='quantitative' />
            <column caption='High Payer Cost' datatype='integer' name='[High_Payer_Cost]' role='measure' type='quantitative' />
            <column caption='Race' datatype='string' name='[RACE]' role='dimension' type='nominal' />
            <column datatype='string' name='[SEX]' role='dimension' type='nominal' />
            <column caption='Age Band' datatype='string' name='[age_band]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1281512268963856]' derivation='None' name='[none:Calculation_1281512268963856:nk]' pivot='key' type='nominal' />
            <column caption='Total Carrier Beneficiary Cost' datatype='real' name='[total_carrier_beneficiary_cost]' role='measure' type='quantitative' />
            <column caption='Total Carrier Insurance Cost' datatype='real' name='[total_carrier_insurance_cost]' role='measure' type='quantitative' />
            <column caption='Total Inpatient Beneficiary Cost' datatype='real' name='[total_inpatient_beneficiary_cost]' role='measure' type='quantitative' />
            <column caption='Total Inpatient Insurance Cost Adj' datatype='real' name='[total_inpatient_insurance_cost_adj]' role='measure' type='quantitative' />
            <column caption='Total Medoop' datatype='real' name='[total_medoop]' role='measure' type='quantitative' />
            <column caption='Total Outpatient Beneficiary Cost' datatype='real' name='[total_outpatient_beneficiary_cost]' role='measure' type='quantitative' />
            <column caption='Total Outpatient Insurance Cost Adj' datatype='real' name='[total_outpatient_insurance_cost_adj]' role='measure' type='quantitative' />
            <column caption='Total Raw Drug Cost' datatype='real' name='[total_raw_drug_cost]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1780141088043021]' derivation='User' name='[usr:Calculation_1780141088043021:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0oc201l09mngjh1bj2k8m1bvnf1p].[Action (Cost Burden Profile (&gt;10% prevalence threshold),Race,SEX,Age Band)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action4_3B5B246D7C82470E862F0511FE351311]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_1281512268963856]' />
              <groupfilter function='level-members' level='[RACE]' />
              <groupfilter function='level-members' level='[SEX]' />
              <groupfilter function='level-members' level='[age_band]' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0oc201l09mngjh1bj2k8m1bvnf1p].[Action (Cost Burden Profile (&gt;10% prevalence threshold),Race,SEX,Age Band)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0oc201l09mngjh1bj2k8m1bvnf1p].[usr:Calculation_1780141088043021:qk]' scope='rows' value='Average Care Cost ($)' />
          </style-rule>
        </style>
        <panes>
